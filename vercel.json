{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/overdue-tasks",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/cron/stale-rooms",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/stale-timers",
      "schedule": "15 1 * * *"
    },
    {
      "path": "/api/cron/attachments",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "0 3 * * *"
    }
  ]
}
