# Required by application services at runtime. Production must use a pooled Neon URL.
DATABASE_URL="postgresql://traketo_app:PASSWORD@HOST/DATABASE?sslmode=require"
# Used only by the controlled migration job; must be a different database role.
MIGRATION_DATABASE_URL="postgresql://traketo_migrator:PASSWORD@HOST/DATABASE?sslmode=require"

# Supabase browser client. Copy these from Supabase > Project Settings > API.
# The publishable key is safe for browser use; never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
# Must be https:// in production.
BETTER_AUTH_URL="http://localhost:3000"

# Optional Google OAuth. Configure both values to enable the Google buttons.
# Google callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Shared cron secret (all jobs). Required in production: Vercel Cron always
# sends this value as the Bearer token.
# Generate with: openssl rand -base64 32
CRON_SECRET="replace-with-at-least-32-random-characters"

# Per-job cron secrets — optional, for schedulers that can set custom headers.
# They are accepted IN ADDITION to the shared secret (never a replacement),
# because native Vercel jobs can only send CRON_SECRET. A leaked per-job
# secret then only exposes that specific job.
# Generate each with: openssl rand -base64 24
CRON_SECRET_STALE_ROOMS=""
CRON_SECRET_STALE_TIMERS=""
CRON_SECRET_REMINDERS=""
CRON_SECRET_ATTACHMENTS=""
CRON_SECRET_OVERDUE=""
CRON_SECRET_RETENTION=""

# Optional: enables the internal /api/ready database probe. Without this value,
# the endpoint is disabled. Send it as: Authorization: Bearer <READINESS_SECRET>
READINESS_SECRET=""

# Required in production for email verification and password recovery.
RESEND_API_KEY="re_replace_me"
EMAIL_FROM="auth@traketo.com"
# Optional separate sender for scheduled task reminders. Defaults to EMAIL_FROM.
REMINDER_FROM_EMAIL=""

# Optional Web Push delivery. Generate a pair with: pnpm exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY="replace-with-vapid-public-key"
VAPID_PRIVATE_KEY="replace-with-vapid-private-key"
VAPID_SUBJECT="mailto:admin@traketo.com"

# Optional Phase 10 private Cloudflare R2 attachment storage. Configure all four.
R2_ACCOUNT_ID="1234567890abcdef1234567890abcdef"
R2_ACCESS_KEY_ID="replace-with-bucket-scoped-access-key"
R2_SECRET_ACCESS_KEY="replace-with-bucket-scoped-secret-key"
R2_BUCKET_NAME="traketo-attachments"
# Optional: Upstash Redis rate limiting. Get credentials at console.upstash.com.
# When absent, rate limiting is skipped gracefully (useful for local dev).
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token-here"

# Set to true ONLY when self-hosting behind a reverse proxy that overwrites
# x-forwarded-for / x-real-ip. Off by default: rate limiting then treats
# untrusted forwarded headers as spoofable and buckets those callers together
# instead of letting attackers rotate fake IPs across limit windows. On
# Vercel, leave this unset — the platform header is always trusted.
TRUST_FORWARDED_IP_HEADERS=""
